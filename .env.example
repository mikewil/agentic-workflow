APP_URL=http://localhost:3000
DATABASE_URL=postgresql://lifecycle_runtime:replace-with-long-runtime-password@localhost:5432/lifecycle
# Used only by migration/bootstrap scripts, never by web or worker containers.
MIGRATION_DATABASE_URL=postgresql://postgres:replace-with-long-owner-password@localhost:5432/lifecycle
POSTGRES_PASSWORD=replace-with-long-owner-password
RUNTIME_DATABASE_PASSWORD=replace-with-long-runtime-password
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BOOTSTRAP_GITHUB_LOGIN=
# Comma-separated private health destinations explicitly trusted by the operator.
HEALTH_ALLOWED_HOSTS=
# Runner-host configuration; not passed to the web or worker.
CONTROL_PLANE_URL=http://localhost:3000
RUNNER_TOKEN=
RUNNER_DATA_DIR=.data/runner
RUNNER_IMAGE=lifecycle-agent:local
OPENAI_API_KEY=
CODEX_MODEL=
